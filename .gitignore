uploads/*.jpg
uploads/*.jpeg
uploads/*.png
uploads/*.bmp
!uploads/.gitkeep

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Distribution / packaging
dist/
build/
*.egg-info/

# Logs
*.log
